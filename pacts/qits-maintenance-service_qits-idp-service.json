          "content": "grant_type=client_credentials&audience=qits-platform",
          "contentType": "application/x-www-form-urlencoded",
          "contentTypeHint": "DEFAULT",
          "encoded": false
        },
        "generators": {
          "header": {
            "Authorization": {
              "dataType": "RAW",
              "expression": "${authorization}",
              "type": "ProviderState"
            }
          }
