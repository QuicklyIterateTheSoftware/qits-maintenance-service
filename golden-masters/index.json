        "failedBumpId": "00000000-0000-4000-8000-000000000002",
        "releasedBumpId": "00000000-0000-4000-8000-000000000003",
        "requestedBumpId": "00000000-0000-4000-8000-000000000004",
        "runningBumpId": "00000000-0000-4000-8000-000000000005"
      },
      "dependsOn": [],
      "operations": [
        {
          "operationId": "listBumps",
